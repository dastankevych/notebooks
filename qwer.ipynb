   "source": [
    "import plotly.graph_objects as go\n",
    "\n",
    "x = [1, 2, 3, 4, 5]\n",
    "y = [10, 14, 12, 18, 16]\n",
    "fig = go.Figure(\n",
    "    data=go.Scatter(x=x, y=y, mode='lines+markers', name='Line Plot')\n",
    ")\n",
    "fig.update_layout(\n",
    "    title='Simple Line Graph',\n",
    "    xaxis_title='X Axis',\n",
    "    yaxis_title='Y Axis'\n",
    ")\n",
    "fig.show()\n"
   ],
